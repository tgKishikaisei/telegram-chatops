# Скопируйте в .env и заполните. Файл .env в git не попадает.
# НА СЕРВЕРЕ секреты — файлами в secrets/ (bot_token, alert_webhook_secret, github_webhook_secret, agent_secret).

# --- Секреты ---
BOT_TOKEN=
# Bearer-токен для Alertmanager/Grafana: openssl rand -hex 32
ALERT_WEBHOOK_SECRET=
# Секрет вебхука GitHub (Settings → Webhooks → Secret): openssl rand -hex 32
GITHUB_WEBHOOK_SECRET=
# Подпись запросов к агенту runbook-действий (тот же секрет — у агента): openssl rand -hex 32
AGENT_SECRET=
# Первые администраторы (через запятую). Остальных добавляют командой /role
ADMIN_IDS=

# --- Команда ---
# Чат команды (супергруппа, бот — участник). ID узнать: добавьте бота и отправьте /whoami
TEAM_CHAT_ID=-1001234567890
# https-адрес веб-процесса для вебхуков: PUBLIC_URL/hooks/alerts, PUBLIC_URL/hooks/github
PUBLIC_URL=https://ops.example.com
DOMAIN=ops.example.com
ACME_EMAIL=admin@example.com
TIMEZONE=Asia/Tashkent
# Critical-инцидент без реакции: через N мин — дежурному, через 2N — всем операторам
ESCALATION_MINUTES=10
# Сколько минут ждёт подтверждения опасное действие
APPROVAL_MINUTES=15

# --- Инфраструктура (локально; в docker-compose.yml задаётся автоматически) ---
DATABASE_URL=sqlite+aiosqlite:///data/chatops.db
# REDIS_URL=redis://localhost:6379/0
LOG_LEVEL=INFO
JSON_LOGS=false
